# Copy this file to .env and fill values locally. Never commit .env.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphrisk
POSTGRES_USER=graphrisk
POSTGRES_PASSWORD=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Stage 07 PostgreSQL mode (explicit opt-in)
GRAPHRISK_STAGE06_CONFIG=configs/stage05.yaml
GRAPHRISK_STAGE07_STORAGE=memory
GRAPHRISK_STAGE07_DSN=
# Optional separate migration/admin and limited application role DSNs
GRAPHRISK_STAGE07_MIGRATION_DSN=
GRAPHRISK_STAGE07_APP_DSN=

# Stage 08 isolated Qwen comparison; put only these three fields in .env.stage08-qwen
DASHSCOPE_API_KEY=
GRAPHRISK_QWEN_ENDPOINT=
GRAPHRISK_STAGE08_LIVE=0

# Stage08 DeepSeek: put these and GRAPHRISK_STAGE08_LIVE in .env.stage08-deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
